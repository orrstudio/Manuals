#!/usr/bin/env bash
# Перевести текст из буфера обмена (trans / Google Translate, онлайн).
# Кириллица -> en, латиница -> ru. Направление определяется по тексту,
# поэтому повторное нажатие переводит обратно.
# Ctrl+Pause:        перевести и заменить буфер.
# Ctrl+Shift+Pause:  перевести, заменить буфер и вставить в курсор.
# При ошибке перевода (нет сети, сервис недоступен) буфер не трогаем.

set -u

PASTE=0
[ "${1:-}" = "--paste" ] && PASTE=1

text="$(wl-paste --no-newline 2>/dev/null || true)"
if [ -z "${text//[[:space:]]/}" ]; then
    notify-send -u normal -a translate-clipboard "Перевод" "Буфер обмена пуст"
    exit 0
fi

# Лимит: Google принимает до ~5000 символов за запрос, берём 4500
if [ "${#text}" -gt 4500 ]; then
    text="${text:0:4500}"
fi

if printf '%s' "$text" | grep -qP '[\x{0400}-\x{04FF}]'; then
    target="en"
else
    target="ru"
fi

translated="$(printf '%s' "$text" | trans -b -no-ansi :"$target" 2>/dev/null)"

# Командная подстановка уже снимает хвостовые переводы строк:
# пусто или одни пробелы = ошибка
if [ -z "${translated//[[:space:]]/}" ]; then
    notify-send -u critical -a translate-clipboard "Перевод" \
        "Не удалось перевести (нет интернета или сервис недоступен). Буфер не тронут."
    exit 1
fi

printf '%s' "$translated" | wl-copy

if [ "$PASTE" -eq 1 ]; then
    sleep 0.1
    # Вставка через ydotool (как в voxtype paste-режиме); wtype в резерв
    if ! ydotool key 29:1 47:1 47:0 29:0 2>/dev/null; then
        wtype -M ctrl -P v -p v -m ctrl
    fi
    notify-send -u normal -a translate-clipboard "Перевод" "Готово ($target), вставлено"
else
    notify-send -u normal -a translate-clipboard "Перевод" "Готово ($target), в буфере"
fi
