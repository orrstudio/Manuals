[Desktop Entry]
Type=Application
Name=Herdr
Comment=Terminal workspace manager for AI coding agents
Exec=env -u HERDR_ENV -u HERDR_SOCKET_PATH -u HERDR_PANE_ID -u HERDR_TAB_ID -u HERDR_WORKSPACE_ID -u HERDR_STARTUP_CWD -u HERDR_BIN_PATH -u TERM_PROGRAM wezterm start --always-new-process -e herdr
Icon=org.wezfurlong.wezterm
Terminal=false
Categories=Development;
Keywords=agents;terminal;ai;
StartupWMClass=org.wezfurlong.wezterm
