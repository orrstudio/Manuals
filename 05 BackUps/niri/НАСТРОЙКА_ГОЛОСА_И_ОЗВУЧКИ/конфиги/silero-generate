#!/home/orr/.local/share/silero-venv/bin/python
# Генерация русского TTS через Silero v4 (офлайн).
# Текст — со stdin, wav — в файл из --out.
# Один кусок:  echo "Привет" | silero-generate --out /tmp/q.wav
# Пакет: куски через разделитель \x1e, --out ШАБЛОН с "##"
#        (## заменяется на номер 01, 02, ...).
# В пакетном режиме куски пишутся сразу после генерации, куск за куском,
# с атомарным переименованием: появившееся имя = готовый файл.
import argparse
import pathlib
import shutil
import subprocess
import sys

import soundfile as sf

SEP = "\x1e"

parser = argparse.ArgumentParser()
parser.add_argument("--voice", default="baya",
                    choices=["baya", "kseniya", "xenia", "aidar", "eugene", "random"])
parser.add_argument("--tempo", type=float, default=1.0,
                    help="1.0 = естественный темп, >1 = быстрее")
parser.add_argument("--out", required=True,
                    help="путь к wav; '##' включает пакетный режим (нумерация 01, 02, ...)")
args = parser.parse_args()

text = sys.stdin.read().replace("\n", " ").strip()
batch = SEP in text
records = [r.strip() for r in text.split(SEP) if r.strip()] if batch else \
          ([text] if text else [])
if not records:
    sys.exit(2)

import torch  # noqa: E402

res = torch.hub.load("snakers4/silero-models", "silero_tts",
                     language="ru", speaker="v4_ru", trust_repo=True)
model = res[0]


def apply_tempo(src: pathlib.Path, dst: pathlib.Path) -> bool:
    """ffmpeg atempo с атомарной заменой; неудача = исходный файл как есть."""
    tmp2 = dst.with_suffix(".atempo.part")
    r = subprocess.run(
        ["ffmpeg", "-y", "-loglevel", "error", "-i", str(src),
         "-filter:a", f"atempo={args.tempo}", "-f", "wav", "-c:a", "pcm_s16le", str(tmp2)],
        capture_output=True,
    )
    if r.returncode == 0 and tmp2.exists():
        tmp2.replace(dst)
        src.unlink(missing_ok=True)
        return True
    tmp2.unlink(missing_ok=True)
    return False


for i, rec in enumerate(records, 1):
    if "##" in args.out:
        out = pathlib.Path(args.out.replace("##", f"{i:02d}"))
    else:
        out = pathlib.Path(args.out)
    tmp = out.with_suffix(out.suffix + ".part")

    audio = model.apply_tts(text=rec, speaker=args.voice, sample_rate=48000,
                            put_accent=True, put_yo=True)
    sf.write(str(tmp), audio.numpy(), 48000, format="WAV")

    used = False
    if abs(args.tempo - 1.0) >= 0.01 and shutil.which("ffmpeg"):
        used = apply_tempo(tmp, out)
    if not used:
        tmp.replace(out)

    if batch:
        print(f"{out.name}", file=sys.stderr, flush=True)
