#!/usr/bin/env python3
# Разбить текст на куски по смене алфавита (кириллица/латиница).
# Нейтральные символы (пробелы, цифры, знаки) прилипают к текущему куску.
# Вход: текст со stdin. Выход: куски через разделитель \x1e.
import re
import sys

SEP = "\x1e"



def letter_class(c):
    """'cyr' / 'lat' для букв, None для нейтральных символов."""
    if re.match(r"[А-Яа-яЁё]", c):
        return "cyr"
    if re.match(r"[A-Za-z]", c):
        return "lat"
    return None


text = sys.stdin.read().replace("\n", " ")

runs = []
cur = []
pending = []
curcls = None

for c in text:
    k = letter_class(c)
    if k is None:
        # нейтральный: ждёт, куда прилипнет (к текущему или следующему куску)
        pending.append(c)
    elif curcls is None:
        cur.extend(pending)
        cur.append(c)
        curcls = k
    elif k == curcls:
        cur.extend(pending)
        pending.clear()
        cur.append(c)
    else:
        cur.extend(pending)
        runs.append("".join(cur))
        cur = [c]
        curcls = k

if cur:
    cur.extend(pending)
    runs.append("".join(cur))
elif pending:
    runs.append("".join(pending))

# Короткие обрывки (цифры, знаки) присоединяем к предыдущему куску
merged = []
for r in runs:
    if merged and len(re.sub(r"[А-Яа-яЁёA-Za-z]", "", r).strip()) < 3 and not re.match(r"[А-Яа-яЁё]", r) and not re.match(r"[A-Za-z]", r):
        merged[-1] += r
    else:
        merged.append(r)

out = [r.strip() for r in merged if r.strip()]
if len(sys.argv) > 1 and sys.argv[1] == "--cyr-only":
    out = [r for r in out if re.search(r"[А-Яа-яЁё]", r)]
sys.stdout.write((SEP.join(out) + SEP) if out else "")
