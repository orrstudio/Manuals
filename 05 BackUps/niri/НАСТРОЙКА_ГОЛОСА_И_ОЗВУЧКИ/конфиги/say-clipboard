#!/usr/bin/env bash
# Озвучить текст из буфера обмена.
# Русский — Silero (Бая), английский — piper (Amy), смешанный — по кускам.
# Режим «проектора»: первый кусок уже играет, пока генерируется следующий.
# Повторное нажатие во время чтения — ПОЛНЫЙ СТОП и выход.
# Смена голосов/темпов/движков — переменными окружения (см. memory.md).

set -u

RUNDIR="/run/user/$(id -u)"
OUT="$RUNDIR/say-clipboard.wav"
PIDF="$RUNDIR/say-clipboard.playpid"

# --- Переключатель: если чтение уже идёт — СТОП и выходим ---
if [ -f "$PIDF" ]; then
    old="$(cat "$PIDF" 2>/dev/null || true)"
    if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
        pkill -f "piper.*say-clipboard" 2>/dev/null || true
        pkill -f "pw-play.*say-clipboard" 2>/dev/null || true
        pkill -f "paplay.*say-clipboard" 2>/dev/null || true
        pkill -f "silero.*say-clipboard" 2>/dev/null || true
        pkill -f "ffmpeg.*say-clipboard" 2>/dev/null || true
        kill "$old" 2>/dev/null || true
        rm -f "$PIDF"
        spd-say -C >/dev/null 2>&1 || true
        exit 0
    fi
    rm -f "$PIDF"
fi

PIPER="$HOME/.local/bin/piper"
VOICES="$HOME/.local/share/piper/voices"
VOICE="${SAY_VOICE:-ru_RU-irina-medium}"
ENG_VOICE="${SAY_VOICE_EN:-en_US-amy-medium}"
# Меньше 1.0 = быстрее. Ирина: 0.6 (≈ +10..25%). Amy (англ.): 0.7 — выбрал пользователь.
SPEED="${SAY_SPEED:-0.7}"
ENG_SPEED="${SAY_SPEED_EN:-0.7}"
OUT="$RUNDIR/say-clipboard.wav"
PLAYER="$(command -v pw-play || command -v paplay || command -v aplay)"

# --- Вспомогательные: воспроизведение с трекингом pid ---
TRACK_PID=0

play_bg() {  # $1 = wav; стартует воспроизведение в фоне, запоминает pid
    "$PLAYER" "$1" 2>/dev/null &
    TRACK_PID=$!
    echo "$TRACK_PID" > "$PIDF"
}

wait_play() {  # дождаться текущего трека; выйти, если нас остановили вторым нажатием
    wait "$TRACK_PID" 2>/dev/null || true
    if [ ! -f "$PIDF" ] || [ "$(cat "$PIDF" 2>/dev/null)" != "$TRACK_PID" ]; then
        # pid-файл убран вторым нажатием — воспроизведение остановлено
        exit 0
    fi
    rm -f "$PIDF"
}

text="$(wl-paste --no-newline 2>/dev/null || true)"

if [ -z "${text//[[:space:]]/}" ]; then
    spd-say -l ru -- "Буфер обмена пуст"
    exit 0
fi

# Ограничение объёма
if [ "${#text}" -gt 2000 ]; then
    text="${text:0:2000}"
fi

SILERO_GEN="$HOME/.local/bin/silero-generate"
SILERO_VOICE="${SILERO_VOICE:-baya}"
SILERO_TEMPO="${SILERO_TEMPO:-1.3}"
SILERO_OK=0
if [ "${SAY_RU_ENGINE:-silero}" = "silero" ] && [ -x "$SILERO_GEN" ]; then
    SILERO_OK=1
fi
PIPER_OK=0
if [ -x "$PIPER" ] && [ -f "$VOICES/$VOICE.onnx" ] && [ -n "$PLAYER" ]; then
    PIPER_OK=1
fi
ENG_PIPER_OK=0
if [ -x "$PIPER" ] && [ -f "$VOICES/$ENG_VOICE.onnx" ] && [ -n "$PLAYER" ]; then
    ENG_PIPER_OK=1
fi

# --- Играть русский кусок (Silero → piper Ирина → RHVoice) ---
play_ru_chunk() {  # $1 текст, $2 wav-файл; success → 0
    if [ "$SILERO_OK" -eq 1 ]; then
        if printf '%s' "$1" | "$SILERO_GEN" --voice "$SILERO_VOICE" --tempo "$SILERO_TEMPO" --out "$2" >/dev/null 2>&1; then
            return 0
        fi
    fi
    if [ "$PIPER_OK" -eq 1 ]; then
        if printf '%s' "$1" | "$PIPER" --model "$VOICES/$VOICE.onnx" --length_scale "$SPEED" --output_file "$2" >/dev/null 2>&1; then
            return 0
        fi
    fi
    # крайний резерв: RHVoice напрямую
    local f txt
    txt="$(printf '%s' "$1" | head -c 500)"
    spd-say -l ru -- "$txt" 2>/dev/null || espeak-ng -s 160 -- "$txt" 2>/dev/null
    return 2
}

# --- Играть английский кусок (piper Amy → spd-say/espeak) ---
play_en_chunk() {  # $1 текст, $2 wav-файл; success → 0
    if [ "$ENG_PIPER_OK" -eq 1 ]; then
        if printf '%s' "$1" | "$PIPER" --model "$VOICES/$ENG_VOICE.onnx" --length_scale "$ENG_SPEED" --output_file "$2" >/dev/null 2>&1; then
            return 0
        fi
    fi
    printf '%s' "$1" | head -c 600 | xargs -0 -I{} spd-say -l en -- "{}" 2>/dev/null || \
        printf '%s' "$1" | head -c 600 | xargs -0 -I{} espeak-ng -s 165 -- "{}" 2>/dev/null
    return 2
}

CYR=0
LAT=0
printf '%s' "$text" | grep -qP '[\x{0400}-\x{04FF}]' && CYR=1
# Латиницы достаточно одной буквы (x, a, CI, main.c — всё → Ирина).
# Закрытые значки (скобки/кавычки/точки) без латинских букв Ирину не включают.
printf '%s' "$text" | grep -qP '[A-Za-z]' && LAT=1

# --- Смешанный текст (кириллица + латиница) целиком — Ирина (piper) ---
# Решение пользователя 2026-11-05: латиница в буфере → Ирина,
# чисто кириллица → Бая. Piper нативный, старт мгновенный, пауз нет.
if [ "$CYR" -eq 1 ] && [ "$LAT" -eq 1 ]; then
    if [ "$PIPER_OK" -eq 1 ]; then
        if printf '%s' "$text" | "$PIPER" --model "$VOICES/$VOICE.onnx" --length_scale "$SPEED" --output_file "$OUT" >/dev/null 2>&1; then
            play_bg "$OUT"
            wait_play
            rm -f "$OUT" 2>/dev/null
            exit 0
        fi
    fi
    # Ирина недоступна → прежняя цепочка (Бая, потом остальные резервы)
    if play_ru_chunk "$text" "$OUT"; then
        play_bg "$OUT"
        wait_play
        rm -f "$OUT" 2>/dev/null
        exit 0
    fi
    exit 0
fi

# --- Только русский ---
if [ "$CYR" -eq 1 ]; then
    if play_ru_chunk "$text" "$OUT"; then
        play_bg "$OUT"
        wait_play
        rm -f "$OUT" 2>/dev/null
        exit 0
    fi
    exit 0
fi

# --- Только английский ---
if [ "$LAT" -eq 1 ]; then
    if play_en_chunk "$text" "$OUT"; then
        play_bg "$OUT"
        wait_play
        rm -f "$OUT" 2>/dev/null
        exit 0
    fi
    exit 0
fi

# --- Не текст ни на том, ни на другом (цифры/знаки) — читаем ru ---
if play_ru_chunk "$text" "$OUT"; then
    play_bg "$OUT"
    wait_play
fi
rm -f "$OUT" 2>/dev/null
